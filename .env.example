# ===== Backend Python (pydantic-settings) =====
PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=mobile_flutter_chat
JWT_SECRET=change_me_with_long_random_string

# ===== Flutter client (flutter_dotenv) =====
# Scheme giao thức kết nối tới backend.
SERVER_SCHEME=http

# Host backend. Sửa theo môi trường:
#   - Máy chủ LAN trong công ty: 192.168.1.20
#   - Máy chủ công khai:          chat.example.com
#   - Android emulator:           10.0.2.2 (đã được hỗ trợ qua SERVER_HOST_ANDROID)
SERVER_HOST=192.168.0.101

# Cổng backend (khớp với PORT ở trên).
SERVER_PORT=3000

# Override theo từng nền tảng - để trống nếu muốn dùng SERVER_HOST chung.
# Lưu ý: Android emulator dùng 10.0.2.2 để trỏ về host machine.
SERVER_HOST_WEB=localhost
SERVER_HOST_ANDROID=192.168.0.101
SERVER_HOST_IOS=localhost